[Unit]
Description=Sync agent skill symlinks from the central skills folder
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Stdlib-only; needs Python 3.12+ (Fedora 44 / Ubuntu 26.04 system python is fine).
ExecStart=/usr/bin/python3 %h/.local/bin/skill-sync --quiet sync
Nice=10
