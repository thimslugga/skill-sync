root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*{sh,bash}]
indent_style = space
indent_size = 2

[*.{py,pyi}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{yml,yaml,json,jsonc,xml,plist}]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 4

[*.{ini,cfg,conf,service,container,timer,path}]
indent_style = space
indent_size = 4

[*.md]
indent_style = space
indent_size = 2
# Trailing double-space is a hard line break in Markdown.
trim_trailing_whitespace = false

